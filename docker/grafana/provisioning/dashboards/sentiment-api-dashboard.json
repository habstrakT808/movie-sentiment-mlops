{
    "dashboard": {
      "id": null,
      "title": "Movie Sentiment Analysis API",
      "tags": ["sentiment", "api", "mlops"],
      "timezone": "browser",
      "panels": [
        {
          "id": 1,
          "title": "Request Rate",
          "type": "stat",
          "targets": [
            {
              "expr": "rate(http_requests_total[5m])",
              "legendFormat": "{{method}} {{endpoint}}"
            }
          ],
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
        },
        {
          "id": 2,
          "title": "Response Time",
          "type": "graph",
          "targets": [
            {
              "expr": "http_request_duration_seconds",
              "legendFormat": "{{method}} {{endpoint}}"
            }
          ],
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
        },
        {
          "id": 3,
          "title": "Predictions Count",
          "type": "stat",
          "targets": [
            {
              "expr": "predictions_total",
              "legendFormat": "{{type}} predictions"
            }
          ],
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
        },
        {
          "id": 4,
          "title": "Model Errors",
          "type": "graph",
          "targets": [
            {
              "expr": "rate(model_errors_total[5m])",
              "legendFormat": "{{error_type}}"
            }
          ],
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
        }
      ],
      "time": {"from": "now-1h", "to": "now"},
      "refresh": "5s"
    }
  }
