{
    "dashboard": {
      "id": null,
      "uid": "movie-sentiment-monitoring",
      "title": "Movie Sentiment Analysis - Model Monitoring",
      "tags": ["mlops", "sentiment-analysis", "monitoring"],
      "timezone": "browser",
      "schemaVersion": 38,
      "version": 1,
      "refresh": "30s",
      "time": {
        "from": "now-1h",
        "to": "now"
      },
      "timepicker": {
        "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"],
        "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "7d", "30d"]
      },
      "panels": [
        {
          "id": 1,
          "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
          "type": "stat",
          "title": "Total Predictions (Rate)",
          "targets": [
            {
              "expr": "sum(rate(predictions_total{job=\"sentiment-api\"}[5m]))",
              "refId": "A",
              "legendFormat": "Predictions/sec"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "green" },
                  { "value": 5, "color": "yellow" },
                  { "value": 10, "color": "red" }
                ]
              },
              "unit": "reqps",
              "decimals": 2
            }
          },
          "options": {
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "orientation": "auto",
            "textMode": "value_and_name",
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto"
          }
        },
        {
          "id": 2,
          "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
          "type": "piechart",
          "title": "Predictions per Type",
          "targets": [
            {
              "expr": "sum by (type) (predictions_total{job=\"sentiment-api\"})",
              "refId": "A",
              "legendFormat": "{{type}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [],
              "unit": "short"
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "values": ["value", "percent"]
            },
            "pieType": "pie",
            "tooltip": {
              "mode": "single"
            },
            "displayLabels": ["name", "percent"]
          }
        },
        {
          "id": 3,
          "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
          "type": "timeseries",
          "title": "Predictions Over Time",
          "targets": [
            {
              "expr": "rate(predictions_total{job=\"sentiment-api\"}[5m])",
              "refId": "A",
              "legendFormat": "{{type}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 20,
                "showPoints": "never",
                "spanNulls": true
              },
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "green" }
                ]
              },
              "unit": "reqps"
            }
          },
          "options": {
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "calcs": ["mean", "last"]
            }
          }
        },
        {
          "id": 4,
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
          "type": "timeseries",
          "title": "API Request Rate",
          "targets": [
            {
              "expr": "sum(rate(http_requests_total{job=\"sentiment-api\"}[5m]))",
              "refId": "A",
              "legendFormat": "Total Requests"
            },
            {
              "expr": "sum by (endpoint) (rate(http_requests_total{job=\"sentiment-api\"}[5m]))",
              "refId": "B",
              "legendFormat": "{{endpoint}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 10,
                "showPoints": "never"
              },
              "unit": "reqps",
              "color": {
                "mode": "palette-classic"
              }
            }
          },
          "options": {
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            },
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": ["mean", "max", "last"]
            }
          }
        },
        {
          "id": 5,
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
          "type": "timeseries",
          "title": "API Response Time (p95)",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"sentiment-api\"}[5m])) by (le, endpoint))",
              "refId": "A",
              "legendFormat": "p95 - {{endpoint}}"
            },
            {
              "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"sentiment-api\"}[5m])) by (le, endpoint))",
              "refId": "B",
              "legendFormat": "p50 - {{endpoint}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 10
              },
              "unit": "s",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "green" },
                  { "value": 0.5, "color": "yellow" },
                  { "value": 1, "color": "red" }
                ]
              }
            }
          },
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": ["mean", "max", "last"]
            }
          }
        },
        {
          "id": 6,
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
          "type": "timeseries",
          "title": "Error Rate",
          "targets": [
            {
              "expr": "sum(rate(http_requests_total{job=\"sentiment-api\", status=~\"5..\"}[5m]))",
              "refId": "A",
              "legendFormat": "5xx Errors"
            },
            {
              "expr": "sum(rate(http_requests_total{job=\"sentiment-api\", status=~\"4..\"}[5m]))",
              "refId": "B",
              "legendFormat": "4xx Errors"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 20
              },
              "unit": "reqps",
              "color": {
                "mode": "fixed",
                "fixedColor": "red"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "green" },
                  { "value": 0.1, "color": "yellow" },
                  { "value": 1, "color": "red" }
                ]
              }
            },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "4xx Errors" },
                "properties": [
                  {
                    "id": "color",
                    "value": { "mode": "fixed", "fixedColor": "orange" }
                  }
                ]
              }
            ]
          },
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          }
        },
        {
          "id": 7,
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
          "type": "barchart",
          "title": "Status Code Distribution",
          "targets": [
            {
              "expr": "sum by (status) (http_requests_total{job=\"sentiment-api\"})",
              "refId": "A",
              "legendFormat": "{{status}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [],
              "unit": "short",
              "color": {
                "mode": "palette-classic"
              }
            }
          },
          "options": {
            "orientation": "horizontal",
            "xTickLabelRotation": 0,
            "xTickLabelSpacing": 100,
            "showValue": "always",
            "legend": {
              "displayMode": "list",
              "placement": "right",
              "calcs": ["sum"]
            },
            "tooltip": {
              "mode": "single"
            }
          }
        },
        {
          "id": 8,
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
          "type": "timeseries",
          "title": "Prediction Duration (p95)",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(prediction_duration_seconds_bucket{job=\"sentiment-api\"}[5m])) by (le, type))",
              "refId": "A",
              "legendFormat": "p95 - {{type}}"
            },
            {
              "expr": "histogram_quantile(0.50, sum(rate(prediction_duration_seconds_bucket{job=\"sentiment-api\"}[5m])) by (le, type))",
              "refId": "B",
              "legendFormat": "p50 - {{type}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 10
              },
              "unit": "s",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "green" },
                  { "value": 0.5, "color": "yellow" },
                  { "value": 1, "color": "red" }
                ]
              }
            }
          },
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": ["mean", "max", "last"]
            }
          }
        },
        {
          "id": 9,
          "gridPos": { "h": 8, "w": 6, "x": 12, "y": 22 },
          "type": "stat",
          "title": "Average Prediction Time",
          "targets": [
            {
              "expr": "avg(rate(prediction_duration_seconds_sum{job=\"sentiment-api\"}[5m]) / rate(prediction_duration_seconds_count{job=\"sentiment-api\"}[5m]))",
              "refId": "A",
              "legendFormat": "Avg Time"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "green" },
                  { "value": 0.5, "color": "yellow" },
                  { "value": 1, "color": "red" }
                ]
              },
              "unit": "s",
              "decimals": 3
            }
          },
          "options": {
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "orientation": "auto",
            "textMode": "value_and_name",
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto"
          }
        },
        {
          "id": 10,
          "gridPos": { "h": 8, "w": 6, "x": 18, "y": 22 },
          "type": "timeseries",
          "title": "Model Errors",
          "targets": [
            {
              "expr": "sum(rate(model_errors_total{job=\"sentiment-api\"}[5m])) by (error_type)",
              "refId": "A",
              "legendFormat": "{{error_type}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 20
              },
              "unit": "reqps",
              "color": {
                "mode": "palette-classic"
              }
            },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "server_error" },
                "properties": [
                  {
                    "id": "color",
                    "value": { "mode": "fixed", "fixedColor": "red" }
                  }
                ]
              },
              {
                "matcher": { "id": "byName", "options": "client_error" },
                "properties": [
                  {
                    "id": "color",
                    "value": { "mode": "fixed", "fixedColor": "orange" }
                  }
                ]
              }
            ]
          },
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          }
        },
        {
          "id": 11,
          "gridPos": { "h": 6, "w": 8, "x": 0, "y": 30 },
          "type": "stat",
          "title": "Total Requests",
          "targets": [
            {
              "expr": "sum(http_requests_total{job=\"sentiment-api\"})",
              "refId": "A",
              "legendFormat": "Total"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "blue" }
                ]
              },
              "unit": "short"
            }
          },
          "options": {
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "orientation": "auto",
            "textMode": "value_and_name",
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto"
          }
        },
        {
          "id": 12,
          "gridPos": { "h": 6, "w": 8, "x": 8, "y": 30 },
          "type": "gauge",
          "title": "Success Rate (%)",
          "targets": [
            {
              "expr": "(sum(rate(http_requests_total{job=\"sentiment-api\", status=~\"2..\"}[5m])) / sum(rate(http_requests_total{job=\"sentiment-api\"}[5m]))) * 100",
              "refId": "A",
              "legendFormat": "Success Rate"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "red" },
                  { "value": 90, "color": "yellow" },
                  { "value": 95, "color": "green" }
                ]
              },
              "unit": "percent",
              "min": 0,
              "max": 100,
              "decimals": 2
            }
          },
          "options": {
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "orientation": "auto",
            "showThresholdLabels": true,
            "showThresholdMarkers": true
          }
        },
        {
          "id": 13,
          "gridPos": { "h": 6, "w": 8, "x": 16, "y": 30 },
          "type": "stat",
          "title": "API Uptime",
          "targets": [
            {
              "expr": "up{job=\"sentiment-api\"}",
              "refId": "A",
              "legendFormat": "Status"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "DOWN",
                      "color": "red"
                    },
                    "1": {
                      "text": "UP",
                      "color": "green"
                    }
                  }
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "value": null, "color": "red" },
                  { "value": 1, "color": "green" }
                ]
              },
              "unit": "short"
            }
          },
          "options": {
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"],
              "fields": ""
            },
            "orientation": "auto",
            "textMode": "value_and_name",
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto"
          }
        }
      ],
      "annotations": {
        "list": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "enable": true,
            "expr": "changes(up{job=\"sentiment-api\"}[5m]) > 0",
            "iconColor": "red",
            "name": "API Restarts",
            "tagKeys": "job",
            "textFormat": "API Restarted",
            "titleFormat": "Service Event"
          }
        ]
      }
    },
    "overwrite": true
  }
