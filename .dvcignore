# Add patterns of files dvc should ignore, which could be large and not relevant
# for example, logs, temporary files, etc.

# Logs
*.log
logs/

# Temporary files
*.tmp
tmp/
temp/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter checkpoints
.ipynb_checkpoints/

# MLflow
mlruns/
mlflow.db

# Model checkpoints (only track final models)
**/checkpoints/
**/checkpoint-*/
